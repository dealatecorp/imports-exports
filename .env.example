APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/harbor.db
UPLOAD_DIR=./data/uploads
APP_TIMEZONE=Asia/Kolkata
# Production only: 64 hexadecimal characters generated securely
MFA_ENCRYPTION_KEY=
# Optional executable called with the quarantined file path; exit 0 = clean
SCAN_COMMAND=
# Demo seeding is explicitly opt-in; never enable on production
ALLOW_DEMO_SEED=false

APP_PRODUCTION=false
